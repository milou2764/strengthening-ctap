+void FidoTunnelDevice::MaybeSendClientAuth() {
+  // Only the QR path carries a client identity key. Paired-device connections
+  // are already bound to a per-device secret and are out of scope.
+  if (!std::holds_alternative<QRInfo>(info_)) {
+    return;
+  }
+  QRInfo& info = std::get<QRInfo>(info_);
+  // The client holds a distinct key per authenticator, so it can only sign once
+  // the peer has said which authenticator it is. That identifier arrives in the
+  // post-handshake message, which is why this runs after it rather than
+  // straight out of the handshake.
+  if (!peer_authenticator_id_.has_value()) {
+    return;
+  }
+  const auto key_it = info.client_identity_keys.find(
+      base::ToLowerASCII(base::HexEncode(*peer_authenticator_id_)));
+  if (key_it == info.client_identity_keys.end()) {
+    FIDO_LOG(DEBUG) << GetId()
+                    << ": no identity key enrolled with this authenticator";
+    return;
+  }
+  const crypto::keypair::PrivateKey& identity_key = key_it->second;
+  const base::TimeTicks t0 = base::TimeTicks::Now();
+
+  // Signed payload binds this client's attestation to (a) the Noise handshake
+  // hash of this specific session -- a strong channel binding that subsumes the
+  // BLE nonce -- and (b) a wall-clock timestamp for replay windowing.
+  cbor::Value::MapValue payload_map;
+  payload_map.emplace(1, base::span<const uint8_t>(*handshake_hash_));
+  payload_map.emplace(2, base::Time::Now().InMillisecondsSinceUnixEpoch());
+  std::optional<std::vector<uint8_t>> payload =
+      cbor::Writer::Write(cbor::Value(std::move(payload_map)));
+
+  // COSE protected header: {1: -7} (alg = ES256), serialized as a bstr.
+  cbor::Value::MapValue protected_map;
+  protected_map.emplace(1, -7);
+  std::optional<std::vector<uint8_t>> protected_bytes =
+      cbor::Writer::Write(cbor::Value(std::move(protected_map)));
+  if (!payload || !protected_bytes) {
+    return;
+  }
+
+  // Sig_structure = ["Signature1", protected, external_aad (empty), payload].
+  cbor::Value::ArrayValue sig_structure;
+  sig_structure.emplace_back(cbor::Value("Signature1"));
+  sig_structure.emplace_back(
+      cbor::Value(base::span<const uint8_t>(*protected_bytes)));
+  sig_structure.emplace_back(cbor::Value(base::span<const uint8_t>()));
+  sig_structure.emplace_back(cbor::Value(base::span<const uint8_t>(*payload)));
+  std::optional<std::vector<uint8_t>> sig_structure_bytes =
+      cbor::Writer::Write(cbor::Value(std::move(sig_structure)));
+  if (!sig_structure_bytes) {
+    return;
+  }
+
+  // crypto::sign::Sign returns a DER-encoded ECDSA signature; COSE ES256 needs
+  // the raw r||s (64 byte) form.
+  const std::vector<uint8_t> der_sig =
+      crypto::sign::Sign(crypto::sign::SignatureKind::ECDSA_SHA256,
+                         identity_key, *sig_structure_bytes);
+  std::optional<std::vector<uint8_t>> raw_sig =
+      crypto::ConvertEcdsaDerSignatureToRaw(
+          crypto::keypair::PublicKey::FromPrivateKey(identity_key),
+          der_sig);
+  if (!raw_sig) {
+    return;
+  }
+
+  // COSE_Sign1 = [protected, {} (unprotected), payload, signature].
+  cbor::Value::ArrayValue cose;
+  cose.emplace_back(cbor::Value(base::span<const uint8_t>(*protected_bytes)));
+  cose.emplace_back(cbor::Value(cbor::Value::MapValue()));
+  cose.emplace_back(cbor::Value(base::span<const uint8_t>(*payload)));
+  cose.emplace_back(cbor::Value(base::span<const uint8_t>(*raw_sig)));
+  std::optional<std::vector<uint8_t>> cose_bytes =
+      cbor::Writer::Write(cbor::Value(std::move(cose)));
+  if (!cose_bytes) {
+    return;
+  }
+
+  // Send as an unsolicited, encrypted post-handshake frame. This is not part of
+  // the request/reply CTAP exchange, so it is written directly rather than via
+  // DeviceTransact (which would treat an unsolicited reply as fatal).
+  std::vector<uint8_t> frame = std::move(*cose_bytes);
+  const size_t cose_size = frame.size();
+  frame.insert(frame.begin(), static_cast<uint8_t>(MessageType::kUpdate));
+  if (crypter_->Encrypt(&frame)) {
+    websocket_client_->Write(frame);
+    const base::TimeTicks t1 = base::TimeTicks::Now();
+    // MEASURE client-auth: build+sign+encrypt cost, wire size, and the delay
+    // between handshake completion and the assertion leaving the client.
+    FIDO_LOG(EVENT) << GetId() << ": MEASURE client-auth sign_us="
+                    << (t1 - t0).InMicroseconds()
+                    << " cose_bytes=" << cose_size
+                    << " frame_bytes=" << frame.size()
+                    << " since_handshake_us="
+                    << (t1 - handshake_done_ticks_).InMicroseconds();
+  }
+}
